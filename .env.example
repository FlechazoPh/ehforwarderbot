# 复制为 .env 并填入你自己的值（.env 已在 .gitignore，不会被提交）。
# 字符串支持 ${VAR} / ${VAR:-default}，profile 下的 config.yaml 会引用这里的变量。

# ===== Telegram 本地 Bot API Server（大文件上传，必填）=====
# 浏览器打开 https://my.telegram.org -> API development tools 创建应用获取
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# ===== ComWeChat VNC 密码（扫码登录微信用，必填）=====
COMWECHAT_VNC_PASSWORD=CHANGE_ME

# ===== 镜像 =====
# 用自建镜像才有 voice_recog / search_msg / flechazo.* 中间件和行为补丁
EFB_IMAGE=efb-custom:v3.1.0-plus
# COMWECHAT_IMAGE=ghcr.io/jiz4oh/comwechat:2026.09.04

# ===== 出站代理（mihomo，见 compose.override.yaml；本机直连 Telegram 受阻时用）=====
# 由 proxy/gen_config.py 从订阅生成 proxy/config.yaml
PROXY_SUB_URL=YOUR_SUBSCRIPTION_URL
# 订阅域名默认解析的部分 IP 不通时，固定到可用 IP（host:port:ip）
PROXY_SUB_RESOLVE=
PROXY_SERVER_IP=
# telegram_bot_api 镜像内透明转发指向的 socks5/http 代理
TGSOCKS_PROXY_HOST=proxy
TGSOCKS_PROXY_PORT=7890

# 目录内还有旧的 docker-compose.yaml，显式指定要加载的 compose 文件
COMPOSE_FILE=compose.yaml:compose.override.yaml

# ===== flechazo.telegraph（链接存档到 Telegraph）=====
# 留空则中间件自动建号，token 存到 profiles/<profile>/flechazo.telegraph/telegraph_token
TELEGRAPH_TOKEN=
# 防盗链图片转存的公开 GitHub 仓库（不存在会自动创建）和有该仓库 Contents 写权限的 token
TELEGRAPH_IMAGE_REPO=your-name/efb-telegraph-assets
TELEGRAPH_IMAGE_GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# ===== flechazo.video_parser（视频链接转视频消息）=====
# 访问 YouTube / X 等境外视频站用的代理（指向上面的 mihomo）
VIDEO_PARSER_PROXY=http://proxy:7890
