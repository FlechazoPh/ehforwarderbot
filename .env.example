# 复制为 .env 并填入真实值。.env 已被 .gitignore，不会入库。
# 所有 ${...} 形式的变量会被 scripts/init_secrets.py 渲染进 profiles/*/config.yaml。

# ---------------------------------------------------------------- 基础 ----
# 明确加载 compose.yaml + compose.override.yaml（目录里还有旧的 docker-compose.yaml）
COMPOSE_FILE=compose.yaml:compose.override.yaml
# 自定义镜像（含补丁，见 Dockerfile）。改回上游镜像会丢失补丁功能。
EFB_IMAGE=efb-custom:v3.1.0-plus
# comwechat 容器 VNC 密码（用于查看微信登录二维码）
COMWECHAT_VNC_PASSWORD=change-me

# ------------------------------------------------------- Telegram 机器人 ----
# BotFather 获取的 token。多 profile 时每个 profile 一个。
TG_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_BOT_TOKEN2=
# 可选：https://my.telegram.org 申请，用于语音识别等
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------------------------------------------------- Telegraph 图文存档 ----
# telegra.ph 账号 token（留空则自动创建）
TELEGRAPH_TOKEN=
# 防盗链图片转存用的 GitHub 仓库（owner/name，不存在会自动创建）
TELEGRAPH_IMAGE_REPO=your-name/efb-telegraph-assets
# 具有 repo 权限的 GitHub PAT
TELEGRAPH_IMAGE_GITHUB_TOKEN=

# ------------------------------------------------------- 视频解析中间件 ----
# 解析/下载视频时使用的代理（与 proxy 服务一致）
VIDEO_PARSER_PROXY=http://proxy:7890
# 自建 ParseHub 服务地址（抖音/快手/微博/小红书 图文与视频解析）
PARSEHUB_API=http://parsehub_service:8000
# 可选：小红书等站点需要的 Cookie（从浏览器复制），填入后成功率更高
PARSEHUB_COOKIE_XHS=
PARSEHUB_COOKIE_DOUYIN=
PARSEHUB_COOKIE_WEIBO=

# ------------------------------------------------------------- 出站代理 ----
# 订阅地址（VLESS 等），由 proxy/gen_config.py 转成 mihomo 配置
PROXY_SUB_URL=
# 本机 DNS 解析出的 Cloudflare IP 可能不通，必要时固定可用 IP
PROXY_SUB_RESOLVE=
PROXY_SERVER_IP=
# Bot API Server 出站的 socks5 代理（mihomo 容器内端口）
TGSOCKS_PROXY_HOST=proxy
TGSOCKS_PROXY_PORT=7890
